# Copy to .env. Keep credentials and local data out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
PROVIDER_TIMEOUT=60

OUTREACH_DB_PATH=outreach.db
CONTEXT_PATH=candidate_context.txt
RESUME_DIR=resumes
OUTREACH_TIMEZONE=Asia/Kolkata
RESUME_ATTACH_MODE=attach

DAILY_SEND_CAP=15
MAX_PER_COMPANY_PER_WEEK=2
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=240
SEND_DAYS=mon,tue,wed,thu,fri
SEND_START_HOUR=9
SEND_END_HOUR=18
FOLLOW_UP_AFTER_DAYS=7
MAX_FOLLOW_UPS=1
MAX_UPLOAD_BYTES=1048576
MAX_RESUME_BYTES=5242880

# Optional local owner login. REQUIRED together for remote hosts.
OWNER_PASSWORD=
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Remote mode also requires HTTPS; see README for reverse-proxy setup.
COOKIE_SECURE=0
