# Copy this file to .env and fill in your own values. Never commit .env.

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Your Gmail address and an App Password (NOT your normal password).
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional overrides — sensible defaults are already set in config.py
# GEMINI_MODEL=gemini-3.1-pro-preview
DAILY_SEND_CAP=15
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=240
FOLLOW_UP_AFTER_DAYS=7

# Deliverability & Send Window settings
# RESUME_ATTACH_MODE=attach   # "attach" (default) or "link"
# SEND_DAYS=Mon,Tue,Wed,Thu,Fri
# SEND_START_HOUR=9
# SEND_END_HOUR=18
